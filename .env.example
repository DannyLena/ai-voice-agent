# Server identity secret — used to AES-256 encrypt/decrypt client credentials at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=your_64_char_hex_key_here

# Firebase / Firestore service account (path to JSON key file)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Optional: override Firestore project ID (defaults to service account project)
# FIRESTORE_PROJECT_ID=your-gcp-project-id

# Server listen config
PORT=3000
HOST=0.0.0.0
